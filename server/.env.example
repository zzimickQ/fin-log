# --- Environment ---
NODE_ENV=development

# --- Database (Postgres via docker compose, host port 5433) ---
DATABASE_URL="postgresql://finlog:finlog@localhost:5433/finlog?schema=public"

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# --- CORS / trusted origins (the web app; comma-separated for several) ---
WEB_ORIGIN=http://localhost:5173

# --- TypeSafe AI (optional; powers smart expense category suggestions) ---
# Get a key at https://console.typesafe.ai/keys. Without it, the server falls
# back to a local token-overlap heuristic and never auto-assigns a category.
# TYPESAFE_API_KEY=ts_...
TYPESAFE_MODEL=jev-latest
# Auto-assign the top category when P(top) >= this; otherwise it is a suggestion.
CATEGORY_AUTO_ASSIGN_THRESHOLD=0.85
# Number of ranked suggestions returned to the UI.
CATEGORY_SUGGESTION_LIMIT=3

# --- Static hosting (optional; unset = API-only server) ---
# Path to a built web app (web/dist) to serve, with SPA fallback to index.html
# WEB_DIST_PATH=../web/dist
