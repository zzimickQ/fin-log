# --- Environment ---
NODE_ENV=development

# --- Database (Postgres via docker compose, host port 5433) ---
DATABASE_URL="postgresql://finlog:finlog@localhost:5433/finlog?schema=public"

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# --- CORS / trusted origins (the web app; comma-separated for several) ---
WEB_ORIGIN=http://localhost:5173

# --- Static hosting (optional; unset = API-only server) ---
# Path to a built web app (web/dist) to serve, with SPA fallback to index.html
# WEB_DIST_PATH=../web/dist
