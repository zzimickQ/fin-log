
// Domain models for Fin Log.
//
// The schema directory (`prisma/`) is merged by Prisma: `auth-schema.prisma`
// provides the generator, datasource and auth tables; this file adds the
// family domain (families, ledgers, expenses, and the recursive category
// tree).
//
// Key design decisions (see docs/basic-doc.md):
//  - Every ledger owns its own self-contained category hierarchy: the
//    categories of one ledger are invisible to another, even inside the
//    same family, so each ledger can structure spending its own way.
//  - The category hierarchy is a self-referencing tree with unlimited depth.
//  - `Expense.categoryId` is optional: "capture first, categorize later".
//  - `occurredAt` (when money was spent) is distinct from `createdAt`.
//  - `paidById` (who actually paid) is distinct from `createdById` (who
//    entered the record).

enum FamilyRole {
  OWNER
  ADMIN
  MEMBER
}

model Family {
  id   String @id @default(cuid())
  name String

  members    FamilyMember[]
  ledgers    Ledger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("family")
}

model FamilyMember {
  id       String     @id @default(cuid())
  familyId String
  userId   String
  role     FamilyRole @default(MEMBER)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([familyId, userId])
  @@index([userId])
  @@index([familyId])
  @@map("family_member")
}

/// User-scoped credential for external clients that submit data on behalf of
/// one user. Only the SHA-256 of the secret is stored; the plaintext key is
/// returned once at creation and can never be read back.
model ApiKey {
  id     String @id @default(cuid())
  userId String

  /// Human label chosen in the admin UI ("Zapier", "phone shortcut").
  name String

  /// SHA-256 hex of the full key. Keys are 256-bit random, so a fast hash is
  /// enough — no bcrypt work factor needed.
  keyHash String @unique

  /// Display-only leading part of the key ("fl_ab12cd34"); identifies a key
  /// in lists once the plaintext is gone.
  prefix String

  /// Last time the key authenticated a request. Written by the ingest
  /// endpoints built on top of this.
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("api_key")
}

/// A transaction parsed out of an inbound message (a bank SMS forwarded by a
/// phone automation) that has not been reviewed yet.
///
/// Deliberately ledgerless: the message says nothing about *why* money moved,
/// so a human picks the ledger and category during review, and the row is then
/// moved into `Expense` and deleted. `source` doubles as the temporary label
/// until someone supplies a real description.
model IncomingTransaction {
  id     String @id @default(cuid())
  userId String

  /// Where the message came from — the SMS sender ("CBE", "Awash Bank").
  /// Used as the temporary label until a real description is entered.
  source String?

  /// The raw message, kept verbatim for review and provenance.
  text String

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("ETB")

  /// When the message was received. Distinct from createdAt because the phone
  /// automation may deliver a message some time after it actually arrived.
  occurredAt DateTime

  /// Label typed during review; becomes the expense description when moved.
  description String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@map("incoming_transaction")
}

model Ledger {
  id       String @id @default(cuid())
  familyId String

  name        String
  description String?

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses Expense[]

  /// Each ledger carries its own category hierarchy (deleted with it).
  categories ExpenseCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([familyId])
  @@map("ledger")
}

model Expense {
  id       String @id @default(cuid())
  ledgerId String

  /// User who recorded the expense.
  createdById String

  /// Optional because an expense can be recorded first and categorized
  /// later (onDelete: SetNull keeps the expense when its category is removed).
  categoryId String?

  /// Who actually paid. Optional — the person entering the expense isn't
  /// necessarily the person who paid it.
  paidById String?

  amount Decimal @db.Decimal(14, 2)
  currency String @default("ETB")

  /// Fast-entry description such as "groceries", "taxi", "coffee".
  description String?
  note String?

  /// When the money was actually spent (distinct from createdAt).
  occurredAt DateTime @default(now())

  ledger   Ledger           @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdBy User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  paidBy   User?            @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId, occurredAt])
  @@index([ledgerId, categoryId])
  @@index([createdById])
  @@index([paidById])
  @@map("expense")
}

model ExpenseCategory {
  id       String @id @default(cuid())
  ledgerId String

  name        String
  description String?

  /// Self-referencing hierarchy: null = root category, otherwise the id of
  /// the parent category. Parents always belong to the same ledger as the
  /// child.
  parentId String?

  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  parent   ExpenseCategory?  @relation("ExpenseCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children ExpenseCategory[] @relation("ExpenseCategoryHierarchy")
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ledgerId])
  @@index([parentId])

  /// Prevent duplicate sibling categories within a ledger, e.g. two "Food"
  /// categories under the same parent. (Postgres treats NULLs as distinct,
  /// so root-level uniqueness is additionally enforced by a partial index
  /// added in the migration, and by the service layer.)
  @@unique([ledgerId, parentId, name])
  @@map("expense_category")
}
